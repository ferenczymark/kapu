# Ide másold a Supabase publikus kulcsát (az API menüpontban találod: "anon public key")
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_sroMUWD6pnJes-7w7FcDUA_YaHYZpNJ

SUPABASE_SERVICE_ROLE_KEY=sb_secret_n0SDe1GykvunQlZiJMRhBA_q0-7g1Yr
# -------------------------------------------------------------------------
# 2. MQTT / MOSQUITTO INTEGRÁCIÓ (Helyi MQTT bróker az ESP32 kommunikációhoz)
# -------------------------------------------------------------------------

# A Mosquitto bróker címe és portja (titkosítás nélküli, sima MQTT az 1883-as porton)
